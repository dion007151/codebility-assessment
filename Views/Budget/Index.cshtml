@model IEnumerable<PimsApp.Models.Project>

@{
    ViewData["Title"] = "Budget Allocation & Validation";
    var currentUser = ViewBag.CurrentUser as PimsApp.Models.User;
}

<div class="pims-card">
    <div class="card-title-bar" style="border-bottom: none; margin-bottom: 0;">
        <div>
            <h3 style="font-size: 1.35rem;">Budget Validation Board</h3>
            <p style="color: var(--slate-600); font-size: 0.85rem; margin: 4px 0 0 0;">Verify executive-approved works and allocate authorized funding limits into the ledger.</p>
        </div>
    </div>
</div>

@if (currentUser?.Role != "Budget")
{
    <div class="alert-pims alert-pims-danger">
        <span class="alert-icon-danger">!</span>
        <div>Access Denied: Only the <strong>Budget Office</strong> can validate and allocate funds. Please switch your simulated role to "Budget Office" to access this panel.</div>
    </div>
}
else
{
    @if (!Model.Any())
    {
        <div class="pims-card" style="text-align: center; padding: 50px 0; color: var(--slate-600);">
            <div style="font-size: 1.5rem; font-weight: 600; margin-bottom: 15px; color: var(--slate-500);">No Pending Items</div>
            <h4>No Pending Validations</h4>
            <p style="margin-top: 5px;">There are no projects currently awaiting budget verification.</p>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 20px;">
            @foreach (var project in Model)
            {
                var isRevision = project.Status == "BudgetRevisionRequired";
                
                <div class="pims-card" style="border-left: 5px solid var(--warning);">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 15px; margin-bottom: 15px; border-bottom: 1px solid var(--slate-100); padding-bottom: 15px;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <h4 style="margin: 0; font-size: 1.2rem;">@project.Title</h4>
                                @if (isRevision)
                                {
                                    <span class="badge-pims badge-revision">Revision Mode</span>
                                }
                            </div>
                            <span style="font-size: 0.8rem; color: var(--slate-600);">Proposed by @project.CreatedBy on @project.DateCreated.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div style="text-align: right;">
                            <span class="switcher-label">Requested Funds</span>
                            <div style="font-size: 1.35rem; font-weight: 800; color: var(--slate-900); margin-top: 4px;">
                                @project.Amount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                            </div>
                        </div>
                    </div>
                    
                    <div style="margin-bottom: 20px;">
                        <span class="switcher-label">Scope & Justification</span>
                        <p style="font-size: 0.9rem; line-height: 1.5; color: var(--slate-700); margin: 6px 0 0 0; white-space: pre-line;">@project.Description</p>
                    </div>

                    <!-- Budget Allocation Form -->
                    <form asp-action="ProcessBudget" method="post" style="background-color: var(--slate-50); padding: 18px; border-radius: var(--radius-sm); border: 1px solid var(--slate-200);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@project.ProjectId" />
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                            <div class="form-group-pims" style="margin-bottom: 0;">
                                <label class="form-label-pims" style="font-size: 0.8rem;">Amount Approved (PHP)</label>
                                <input name="amountApproved" type="number" step="0.01" value="@project.Amount" class="form-input-pims" required />
                            </div>
                            <div class="form-group-pims" style="margin-bottom: 0;">
                                <label class="form-label-pims" style="font-size: 0.8rem;">Budget Allocation Remarks</label>
                                <input name="remarks" type="text" class="form-input-pims" placeholder="e.g. Validated. Funds approved under infra development appropriation." required />
                            </div>
                        </div>

                        <div style="display: flex; gap: 10px; justify-content: flex-end;">
                            <button type="submit" name="actionType" value="Revision" class="btn-pims btn-pims-secondary">
                                Return for Revision
                            </button>
                            <button type="submit" name="actionType" value="Approve" class="btn-pims btn-pims-success">
                                Validate & Approve Budget
                            </button>
                        </div>
                    </form>
                </div>
            }
        </div>
    }
}
