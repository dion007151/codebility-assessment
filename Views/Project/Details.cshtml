@model PimsApp.Models.Project

@{
    ViewData["Title"] = "Project Tracking & Workflow";
    var currentUser = ViewBag.CurrentUser as PimsApp.Models.User;
    var logs = ViewBag.WorkflowLogs as List<PimsApp.Models.WorkflowLog> ?? new List<PimsApp.Models.WorkflowLog>();

    var status = Model.Status;

    // Define helper to check status sequence
    bool IsPastOrEqual(string checkStatus)
    {
        var sequence = new List<string> {
            "Draft", "Submitted", "ApprovedGovernor", "BudgetApproved", "ProcurementBidding", "ProcurementAwarded", "VoucherGenerated", "PaymentCompleted"
        };
        var currentIdx = sequence.IndexOf(status);
        var targetIdx = sequence.IndexOf(checkStatus);
        
        if (status == "RejectedGovernor")
        {
            if (checkStatus == "Draft" || checkStatus == "Submitted") return true;
            return false;
        }
        if (status == "BudgetRevisionRequired")
        {
            if (checkStatus == "Draft" || checkStatus == "Submitted" || checkStatus == "ApprovedGovernor") return true;
            return false;
        }

        return currentIdx >= targetIdx;
    }

    // Determine state classes for the 6 steps
    string step1Cls = status == "Draft" ? "active" : "completed";
    
    string step2Cls = status == "Submitted" ? "active" 
                    : (status == "RejectedGovernor" ? "rejected" 
                    : (IsPastOrEqual("ApprovedGovernor") ? "completed" : "pending"));
                    
    string step3Cls = (status == "ApprovedGovernor") ? "active" 
                    : (status == "BudgetRevisionRequired" ? "rejected" 
                    : (IsPastOrEqual("BudgetApproved") ? "completed" : "pending"));
                    
    string step4Cls = (status == "BudgetApproved" || status == "ProcurementBidding") ? "active" 
                    : (IsPastOrEqual("ProcurementAwarded") ? "completed" : "pending");
                    
    string step5Cls = status == "ProcurementAwarded" ? "active" 
                    : (IsPastOrEqual("VoucherGenerated") ? "completed" : "pending");
                    
    string step6Cls = status == "VoucherGenerated" ? "active" 
                    : (status == "PaymentCompleted" ? "completed" : "pending");

    // Fetch specific log events
    var log1 = logs.FirstOrDefault(l => l.Status == "Draft" || l.Status == "Submitted");
    var log2 = logs.LastOrDefault(l => l.Status == "ApprovedGovernor" || l.Status == "RejectedGovernor");
    var log3 = logs.LastOrDefault(l => l.Status == "BudgetApproved" || l.Status == "BudgetRevisionRequired");
    var log4 = logs.LastOrDefault(l => l.Status == "ProcurementAwarded" || l.Status == "ProcurementBidding");
    var log5 = logs.LastOrDefault(l => l.Status == "VoucherGenerated");
    var log6 = logs.LastOrDefault(l => l.Status == "PaymentCompleted");
}

<div class="pims-card">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <span class="badge-pims @(status.ToLower() switch {
                "draft" => "badge-draft",
                "submitted" => "badge-submitted",
                "approvedgovernor" => "badge-approved-gov",
                "rejectedgovernor" => "badge-rejected-gov",
                "budgetapproved" => "badge-budget-approved",
                "budgetrevisionrequired" => "badge-revision",
                "procurementbidding" => "badge-bidding",
                "procurementawarded" => "badge-awarded",
                "vouchergenerated" => "badge-voucher",
                "paymentcompleted" => "badge-completed",
                _ => "badge-draft"
            })">@Model.Status</span>
            <h2 style="margin: 8px 0 0 0; font-size: 1.6rem;">@Model.Title</h2>
            <p style="color: var(--slate-600); margin: 4px 0 0 0; font-size: 0.85rem;">Project ID: #@Model.ProjectId | Encoded on @Model.DateCreated.ToString("MMM dd, yyyy") by @Model.CreatedBy</p>
        </div>
        <div style="display: flex; gap: 10px;">
            <a href="@Url.Action("Index")" class="btn-pims btn-pims-secondary">Back to Registry</a>
            @if ((status == "Draft" || status == "BudgetRevisionRequired" || status == "RejectedGovernor") && currentUser?.Role == "OPPDC")
            {
                <form asp-action="Submit" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ProjectId" />
                    <button type="submit" class="btn-pims btn-pims-primary">
                        @(status == "Draft" ? "Submit to Governor" : "Resubmit to Governor")
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<div class="dashboard-grid">
    <!-- Left Column: Details & Document Logs -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- Premium Tab Navigation Bar -->
        <div class="tabs-navigation">
            <button class="tab-btn active" data-tab="overview">
                <span>📋</span> Overview
            </button>
            <button class="tab-btn" data-tab="milestones">
                <span>🗺️</span> Milestones
            </button>
            <button class="tab-btn" data-tab="technical">
                <span>📐</span> Technical Docs
            </button>
            <button class="tab-btn" data-tab="procurement">
                <span>🤝</span> Procurement
            </button>
            <button class="tab-btn" data-tab="monitoring">
                <span>📊</span> Monitoring
            </button>
            <button class="tab-btn" data-tab="financials">
                <span>🏦</span> Financials
            </button>
        </div>

        <!-- TAB 1: OVERVIEW -->
        <div class="tab-pane active" id="overview">
            <div class="pims-card">
                <div class="card-title-bar">
                    <h3 class="tab-section-title">Overview & Proposal Profile</h3>
                </div>
                
                <div style="margin-bottom: 20px;">
                    <span class="switcher-label">Scope of Work</span>
                    <p style="margin: 8px 0 0 0; font-size: 0.95rem; line-height: 1.6; color: var(--slate-800); white-space: pre-line;">@Model.Description</p>
                </div>

                <div class="info-grid-pims" style="border-top: 1px solid var(--slate-200); padding-top: 20px;">
                    <div class="info-field-pims">
                        <span class="info-field-label">AIP Code</span>
                        <span class="info-field-value">@(Model.AipCode ?? "N/A")</span>
                    </div>
                    <div class="info-field-pims">
                        <span class="info-field-label">Assigned Department</span>
                        <span class="info-field-value">@(Model.Department?.DepartmentName ?? "Unassigned")</span>
                    </div>
                    <div class="info-field-pims">
                        <span class="info-field-label">Funding Request</span>
                        <span class="info-field-value" style="font-size: 1.25rem; font-weight: 800; color: var(--slate-900);">
                            @Model.Amount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                        </span>
                    </div>
                    <div class="info-field-pims">
                        <span class="info-field-label">Fiduciary Officer</span>
                        <span class="info-field-value">@Model.CreatedBy (OPPDC)</span>
                    </div>
                </div>
            </div>

            <!-- Governor Approvals -->
            @if (Model.Approvals != null && Model.Approvals.Any())
            {
                <div class="pims-card" style="border-left: 4px solid var(--primary-light);">
                    <div class="card-title-bar">
                        <h3>Governor Review Details</h3>
                    </div>
                    @foreach (var approval in Model.Approvals)
                    {
                        <div style="font-size: 0.9rem; margin-bottom: 16px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span>Decision: <strong class="@(approval.Status == "Approved" ? "text-success-pims" : "text-danger-pims")">@approval.Status</strong></span>
                                <span class="timeline-time">@approval.Date.ToString("MMM dd, yyyy hh:mm tt")</span>
                            </div>
                            <div style="margin-bottom: 6px;">Reviewed by: <strong>@approval.ApprovedBy</strong></div>
                            <p class="timeline-remarks">Remarks: "@approval.Remarks"</p>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- TAB 2: MILESTONES & STAGES -->
        <div class="tab-pane" id="milestones">
            <div class="pims-card">
                <div class="card-title-bar">
                    <h3 class="tab-section-title">Project Road Map & Stages</h3>
                </div>
                <p class="tab-section-desc">Roadmap of structured workflow stages required for full clearance and closeout.</p>

                @if (Model.ProjectStages != null && Model.ProjectStages.Any())
                {
                    <div class="milestone-list-pims">
                        @foreach (var stage in Model.ProjectStages.OrderBy(s => s.OrderNo))
                        {
                            string stageCls = stage.Status == "Completed" ? "completed" 
                                            : (stage.Status == "In Progress" ? "in-progress" : "pending");
                            
                            string badgeStyle = stage.Status == "Completed" ? "badge-completed" 
                                              : (stage.Status == "In Progress" ? "badge-submitted" : "badge-draft");

                            <div class="milestone-card-pims @stageCls">
                                <div class="milestone-info-pims">
                                    <div class="milestone-title-pims">
                                        <span>Step @stage.OrderNo:</span> @stage.StageName
                                    </div>
                                    <div class="milestone-desc-pims">@stage.Description</div>
                                    @if (stage.TargetDate.HasValue)
                                    {
                                        <div class="milestone-date-pims">Target Completion: @stage.TargetDate.Value.ToString("MMMM dd, yyyy")</div>
                                    }
                                </div>
                                <div>
                                    <span class="badge-pims @badgeStyle">@stage.Status</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p style="color: var(--slate-600); font-style: italic;">No workflow milestones have been defined for this project's current state.</p>
                }
            </div>
        </div>

        <!-- TAB 3: TECHNICAL DOCUMENTS -->
        <div class="tab-pane" id="technical">
            <div class="pims-card">
                <div class="card-title-bar">
                    <h3 class="tab-section-title">Technical Specifications & Blueprints</h3>
                </div>
                <p class="tab-section-desc">Detailed blueprints, designs, and cost calculations encoded by municipal planners.</p>

                @if ((Model.TechnicalDocuments != null && Model.TechnicalDocuments.Any()) || (Model.ProjectDocuments != null && Model.ProjectDocuments.Any()))
                {
                    <div class="doc-grid-pims">
                        <!-- Render Technical Documents -->
                        @if (Model.TechnicalDocuments != null)
                        {
                            @foreach (var techDoc in Model.TechnicalDocuments)
                            {
                                <div class="doc-card-pims">
                                    <div class="doc-icon-pims">📐</div>
                                    <div class="doc-body-pims">
                                        <div class="doc-name-pims" title="@techDoc.DocName">@techDoc.DocName</div>
                                        <div class="doc-meta-pims">File: @System.IO.Path.GetFileName(techDoc.FilePath)</div>
                                        <div class="doc-meta-pims">Uploaded: @techDoc.UploadedAt.ToString("MMM dd, yyyy") by @techDoc.UploadedBy</div>
                                        @if (!string.IsNullOrEmpty(techDoc.Remarks))
                                        {
                                            <div class="doc-meta-pims" style="margin-top: 4px; font-style: italic; color: var(--slate-700);">"@techDoc.Remarks"</div>
                                        }
                                    </div>
                                </div>
                            }
                        }

                        <!-- Render Project Proposals / Ordinances -->
                        @if (Model.ProjectDocuments != null)
                        {
                            @foreach (var projDoc in Model.ProjectDocuments)
                            {
                                <div class="doc-card-pims">
                                    <div class="doc-icon-pims">📋</div>
                                    <div class="doc-body-pims">
                                        <div class="doc-name-pims" title="@projDoc.FileName">@projDoc.FileName</div>
                                        <div class="doc-meta-pims">Type: @projDoc.DocType</div>
                                        <div class="doc-meta-pims">Uploaded: @projDoc.UploadedAt.ToString("MMM dd, yyyy") by @projDoc.UploadedBy</div>
                                        @if (!string.IsNullOrEmpty(projDoc.Remarks))
                                        {
                                            <div class="doc-meta-pims" style="margin-top: 4px; font-style: italic; color: var(--slate-700);">"@projDoc.Remarks"</div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <p style="color: var(--slate-600); font-style: italic;">No technical engineering layouts or proposals have been uploaded yet.</p>
                }
            </div>
        </div>

        <!-- TAB 4: PROCUREMENT & CONTRACTOR -->
        <div class="tab-pane" id="procurement">
            <div class="pims-card">
                <div class="card-title-bar">
                    <h3 class="tab-section-title">Bidding, Procurement & Awards</h3>
                </div>
                <p class="tab-section-desc">Bids and Awards Committee (BAC) proceedings, winning contractors, and philGEPS postings.</p>

                @if (Model.Procurements != null && Model.Procurements.Any())
                {
                    @foreach (var proc in Model.Procurements)
                    {
                        <div style="border-bottom: 1px solid var(--slate-200); padding-bottom: 20px; margin-bottom: 20px;">
                            <div class="info-grid-pims">
                                <div class="info-field-pims">
                                    <span class="info-field-label">Award Status</span>
                                    <span class="info-field-value">
                                        <span class="badge-pims @(proc.Status == "Awarded" ? "badge-awarded" : "badge-bidding")">@proc.Status</span>
                                    </span>
                                </div>
                                <div class="info-field-pims">
                                    <span class="info-field-label">Award Date</span>
                                    <span class="info-field-value">@proc.Date.ToString("MMMM dd, yyyy")</span>
                                </div>
                                <div class="info-field-pims">
                                    <span class="info-field-label">Winning Bidder</span>
                                    <span class="info-field-value" style="font-size: 1.1rem; color: var(--primary-light);">@proc.Supplier</span>
                                </div>
                                <div class="info-field-pims">
                                    <span class="info-field-label">BAC Proceedings</span>
                                    <span class="info-field-value" style="font-weight: normal; font-size: 0.88rem; color: var(--slate-700);">"@proc.BACRemarks"</span>
                                </div>
                            </div>

                            @if (proc.Contractor != null)
                            {
                                <div style="background-color: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-sm); padding: 16px; margin-top: 16px;">
                                    <h4 style="margin: 0 0 12px 0; font-size: 0.95rem; color: var(--slate-900); display: flex; align-items: center; gap: 8px;">
                                        <span>🏗️</span> Winning Contractor Profile
                                    </h4>
                                    <div class="info-grid-pims">
                                        <div class="info-field-pims">
                                            <span class="info-field-label">PCAB Registration</span>
                                            <span class="info-field-value">@proc.Contractor.RegistrationNo</span>
                                        </div>
                                        <div class="info-field-pims">
                                            <span class="info-field-label">Contact Person</span>
                                            <span class="info-field-value">@proc.Contractor.ContactPerson</span>
                                        </div>
                                        <div class="info-field-pims">
                                            <span class="info-field-label">Fulfillment Address</span>
                                            <span class="info-field-value">@proc.Contractor.Address</span>
                                        </div>
                                        <div class="info-field-pims">
                                            <span class="info-field-label">Contractor Contact</span>
                                            <span class="info-field-value">@proc.Contractor.Phone | @proc.Contractor.Email</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (proc.ProcurementDocuments != null && proc.ProcurementDocuments.Any())
                            {
                                <div style="margin-top: 16px;">
                                    <h5 style="margin: 0 0 10px 0; font-size: 0.85rem; text-transform: uppercase; color: var(--slate-600); letter-spacing: 0.5px;">Bidding & Clearance Artifacts</h5>
                                    <div class="doc-grid-pims">
                                        @foreach (var pDoc in proc.ProcurementDocuments)
                                        {
                                            <div class="doc-card-pims">
                                                <div class="doc-icon-pims">🤝</div>
                                                <div class="doc-body-pims">
                                                    <div class="doc-name-pims" title="@pDoc.FileName">@pDoc.FileName</div>
                                                    <div class="doc-meta-pims">Type: @pDoc.DocType</div>
                                                    <div class="doc-meta-pims">Uploaded: @pDoc.UploadedAt.ToString("MMM dd, yyyy")</div>
                                                    @if (!string.IsNullOrEmpty(pDoc.Remarks))
                                                    {
                                                        <div class="doc-meta-pims" style="margin-top: 4px; font-style: italic; color: var(--slate-700);">"@pDoc.Remarks"</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p style="color: var(--slate-600); font-style: italic;">Procurement phase has not been initiated for this project proposal yet.</p>
                }
            </div>
        </div>

        <!-- TAB 5: MONITORING & PROGRESS -->
        <div class="tab-pane" id="monitoring">
            <div class="pims-card">
                <div class="card-title-bar">
                    <h3 class="tab-section-title">Physical Progress & Engineering Inspections</h3>
                </div>
                <p class="tab-section-desc">On-site quality reviews and physical execution reports logged by the Provincial Engineering Office (PEO).</p>

                @if (Model.ProjectMonitorings != null && Model.ProjectMonitorings.Any())
                {
                    var latestMonitoring = Model.ProjectMonitorings.OrderByDescending(m => m.InspectionDate).First();
                    
                    <div class="progress-banner-pims">
                        <div>
                            <div style="font-weight: 700; font-size: 1.05rem; margin-bottom: 4px;">Fulfillment Execution Progress</div>
                            <div style="font-size: 0.8rem; opacity: 0.8;">Latest Inspection: @latestMonitoring.InspectionDate.ToString("MMMM dd, yyyy") by @latestMonitoring.InspectedBy</div>
                        </div>
                        <div class="progress-metric-pims">
                            <span class="progress-percentage-pims">@latestMonitoring.ProgressPercent%</span>
                            <span class="badge-pims badge-completed" style="margin-top: 4px;">@latestMonitoring.Status</span>
                        </div>
                    </div>

                    <h4 style="margin: 20px 0 12px 0; font-size: 0.95rem;">Historical Inspection Feed</h4>
                    <div class="monitoring-timeline-pims">
                        @foreach (var inspection in Model.ProjectMonitorings.OrderByDescending(m => m.InspectionDate))
                        {
                            <div class="monitoring-item-pims">
                                <div class="monitoring-header-pims">
                                    <strong>@inspection.InspectedBy</strong>
                                    <span style="color: var(--slate-600);">@inspection.InspectionDate.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                                <div style="font-size: 0.82rem; color: var(--primary-light); font-weight: 700; margin-bottom: 6px;">
                                    Physical Progress Milestone: @inspection.ProgressPercent% | Status: @inspection.Status
                                </div>
                                <p class="monitoring-remarks-pims">@inspection.Remarks</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="progress-banner-pims">
                        <div>
                            <div style="font-weight: 700; font-size: 1.05rem; margin-bottom: 4px;">Fulfillment Execution Progress</div>
                            <div style="font-size: 0.8rem; opacity: 0.8;">Awaiting initial groundbreaking and engineer inspection log.</div>
                        </div>
                        <div class="progress-metric-pims">
                            <span class="progress-percentage-pims">0%</span>
                            <span class="badge-pims badge-draft" style="margin-top: 4px;">Awaiting Entry</span>
                        </div>
                    </div>
                    <p style="color: var(--slate-600); font-style: italic;">No on-site engineering quality inspection logs have been registered.</p>
                }
            </div>
        </div>

        <!-- TAB 6: FINANCIALS -->
        <div class="tab-pane" id="financials">
            <div class="pims-card">
                <div class="card-title-bar">
                    <h3 class="tab-section-title">Treasury Fiduciary & Treasury Cash Certifications</h3>
                </div>
                <p class="tab-section-desc">Cash certifications, budget validations, and check disbursements processed for this project.</p>

                <!-- 1. Treasury Cash Certifications -->
                <div style="margin-bottom: 24px;">
                    <h4 style="margin: 0 0 12px 0; font-size: 0.95rem; color: var(--slate-900); display: flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--slate-100); padding-bottom: 6px;">
                        <span>💰</span> Cash availability certifications
                    </h4>
                    @if (Model.CashCertifications != null && Model.CashCertifications.Any())
                    {
                        @foreach (var cert in Model.CashCertifications)
                        {
                            <div style="background-color: var(--success-light); border-left: 4px solid var(--success); border-radius: var(--radius-sm); padding: 16px; margin-bottom: 12px;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 0.88rem;">
                                    <span style="color: #065f46; font-weight: 700;">Status: @cert.Status</span>
                                    <span style="color: var(--slate-700);">Certified: @cert.CertifiedAt.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                                <div style="font-size: 1.25rem; font-weight: 800; color: #065f46; margin-bottom: 8px;">
                                    @cert.AmountCertified.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                                </div>
                                <div style="font-size: 0.84rem; color: var(--slate-800);">
                                    Treasurer Officer: <strong>@cert.CertifiedBy</strong>
                                </div>
                                <p style="margin: 6px 0 0 0; font-size: 0.84rem; color: var(--slate-700); font-style: italic;">"@cert.Remarks"</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: var(--slate-600); font-style: italic; font-size: 0.85rem;">No cash availability certification has been declared by the treasury office yet.</p>
                    }
                </div>

                <!-- 2. Budget Office Validations -->
                <div style="margin-bottom: 24px;">
                    <h4 style="margin: 0 0 12px 0; font-size: 0.95rem; color: var(--slate-900); display: flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--slate-100); padding-bottom: 6px;">
                        <span>📊</span> Budget Office allocation validations
                    </h4>
                    @if (Model.BudgetValidations != null && Model.BudgetValidations.Any())
                    {
                        @foreach (var budget in Model.BudgetValidations)
                        {
                            <div style="background-color: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-sm); padding: 16px; margin-bottom: 12px;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 0.88rem;">
                                    <span>Validation Decision: <strong class="text-success-pims">@budget.Status</strong></span>
                                    <span style="color: var(--slate-600);">Date: @budget.Date.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div style="font-size: 1.15rem; font-weight: 800; color: var(--slate-900); margin-bottom: 8px;">
                                    @budget.AmountApproved.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                                </div>
                                <div style="font-size: 0.84rem;">
                                    Budget Officer: <strong>@budget.BudgetOfficer</strong>
                                </div>
                                <p style="margin: 6px 0 0 0; font-size: 0.84rem; color: var(--slate-700); font-style: italic;">Remarks: "@budget.Remarks"</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: var(--slate-600); font-style: italic; font-size: 0.85rem;">Awaiting executive review approval to release validation steps.</p>
                    }
                </div>

                <!-- 3. Financial & Check Vouchers -->
                <div>
                    <h4 style="margin: 0 0 12px 0; font-size: 0.95rem; color: var(--slate-900); display: flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--slate-100); padding-bottom: 6px;">
                        <span>🎫</span> Accounting Vouchers & Disbursements
                    </h4>
                    @if (Model.Vouchers != null && Model.Vouchers.Any())
                    {
                        @foreach (var voucher in Model.Vouchers)
                        {
                            <div style="background-color: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-sm); padding: 16px; margin-bottom: 12px;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 0.88rem;">
                                    <span>Voucher Reference ID: <strong>#V-@voucher.VoucherId</strong></span>
                                    <span style="color: var(--slate-600);">Date: @voucher.Date.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div style="font-size: 1.15rem; font-weight: 800; color: var(--slate-900); margin-bottom: 8px;">
                                    @voucher.Amount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                                </div>
                                <div style="font-size: 0.84rem;">
                                    Accountant Ledger Invoicing: <strong>Certified by @voucher.GeneratedBy</strong>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: var(--slate-600); font-style: italic; font-size: 0.85rem;">Pending bid contract awards before accountant ledger invoicing.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Interactive Timeline Tracking -->
    <div>
        <div class="pims-card">
            <div class="card-title-bar">
                <h3>Workflow Tracker</h3>
            </div>
            
            <div class="timeline-pims">
                
                <!-- STEP 1: Encoding -->
                <div class="timeline-item @step1Cls">
                    <div class="timeline-icon">1</div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h4 class="timeline-title">Project Initiation</h4>
                            @if (log1 != null) { <span class="timeline-time">@log1.Timestamp.ToString("MMM dd")</span> }
                        </div>
                        <div class="timeline-meta">Role: OPPDC Planner</div>
                        @if (log1 != null)
                        {
                            <p class="timeline-remarks">@log1.Remarks (by @log1.UpdatedBy)</p>
                        }
                        else
                        {
                            <p class="timeline-remarks">Draft proposal encoded.</p>
                        }
                    </div>
                </div>

                <!-- STEP 2: Governor Approval -->
                <div class="timeline-item @step2Cls">
                    <div class="timeline-icon">@if(step2Cls == "rejected") { <span>X</span> } else { <span>2</span> }</div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h4 class="timeline-title">Executive Approval</h4>
                            @if (log2 != null) { <span class="timeline-time">@log2.Timestamp.ToString("MMM dd")</span> }
                        </div>
                        <div class="timeline-meta">Role: Governor</div>
                        @if (log2 != null)
                        {
                            <p class="timeline-remarks">Remarks: "@log2.Remarks" (by @log2.UpdatedBy)</p>
                        }
                        else
                        {
                            <p class="timeline-remarks" style="color: var(--slate-600);">Pending submission for executive endorsement.</p>
                        }
                    </div>
                </div>

                <!-- STEP 3: Budget Validation -->
                <div class="timeline-item @step3Cls">
                    <div class="timeline-icon">@if(step3Cls == "rejected") { <span>!</span> } else { <span>3</span> }</div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h4 class="timeline-title">Budget Validation</h4>
                            @if (log3 != null) { <span class="timeline-time">@log3.Timestamp.ToString("MMM dd")</span> }
                        </div>
                        <div class="timeline-meta">Role: Budget Office</div>
                        @if (log3 != null)
                        {
                            <p class="timeline-remarks">Remarks: "@log3.Remarks" (by @log3.UpdatedBy)</p>
                        }
                        else
                        {
                            <p class="timeline-remarks" style="color: var(--slate-600);">Awaiting Governor's approval to release validation steps.</p>
                        }
                    </div>
                </div>

                <!-- STEP 4: Procurement Bidding -->
                <div class="timeline-item @step4Cls">
                    <div class="timeline-icon">4</div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h4 class="timeline-title">Procurement & Awards</h4>
                            @if (log4 != null) { <span class="timeline-time">@log4.Timestamp.ToString("MMM dd")</span> }
                        </div>
                        <div class="timeline-meta">Role: BAC Committee</div>
                        @if (log4 != null)
                        {
                            <p class="timeline-remarks">@log4.Remarks (by @log4.UpdatedBy)</p>
                        }
                        else
                        {
                            <p class="timeline-remarks" style="color: var(--slate-600);">Awaiting budget validation before initiating bid processes.</p>
                        }
                    </div>
                </div>

                <!-- STEP 5: Voucher Generation -->
                <div class="timeline-item @step5Cls">
                    <div class="timeline-icon">5</div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h4 class="timeline-title">Voucher Processing</h4>
                            @if (log5 != null) { <span class="timeline-time">@log5.Timestamp.ToString("MMM dd")</span> }
                        </div>
                        <div class="timeline-meta">Role: Accountant</div>
                        @if (log5 != null)
                        {
                            <p class="timeline-remarks">@log5.Remarks (by @log5.UpdatedBy)</p>
                        }
                        else
                        {
                            <p class="timeline-remarks" style="color: var(--slate-600);">Pending bid contract awards before accountant ledger invoicing.</p>
                        }
                    </div>
                </div>

                <!-- STEP 6: Payment completed -->
                <div class="timeline-item @step6Cls">
                    <div class="timeline-icon">6</div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h4 class="timeline-title">Payment Release</h4>
                            @if (log6 != null) { <span class="timeline-time">@log6.Timestamp.ToString("MMM dd")</span> }
                        </div>
                        <div class="timeline-meta">Role: Treasurer</div>
                        @if (log6 != null)
                        {
                            <p class="timeline-remarks">@log6.Remarks (by @log6.UpdatedBy)</p>
                        }
                        else
                        {
                            <p class="timeline-remarks" style="color: var(--slate-600);">Awaiting ledger voucher generation before check disbursement.</p>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Interactive Tab Switcher
            $('.tab-btn').on('click', function() {
                var targetTab = $(this).data('tab');
                
                // Toggle active button class
                $('.tab-btn').removeClass('active');
                $(this).addClass('active');
                
                // Toggle active tab pane with fade-in effect
                $('.tab-pane').removeClass('active');
                $('#' + targetTab).addClass('active');
            });
        });
    </script>
}
